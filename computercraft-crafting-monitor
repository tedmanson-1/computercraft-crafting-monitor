local bridge = peripheral.wrap("bottom")
local monitor = peripheral.find("monitor")

if not bridge then error("ME Bridge not found on BOTTOM!") end
if not monitor then error("Monitor not found!") end

monitor.setTextScale(0.5)

-- Deep search function to find values in the messy AE2 tables
local function findValue(tbl, key)
    if type(tbl) ~= "table" then return nil end
    if tbl[key] then return tbl[key] end
    for _, v in pairs(tbl) do
        local res = findValue(v, key)
        if res then return res end
    end
    return nil
end

function updateDisplay()
    monitor.clear()
    monitor.setCursorPos(1, 1)
    monitor.setTextColor(colors.yellow)
    monitor.write("--- AE2 Active Crafting ---")
    
    local cpus = bridge.getCraftingCPUs()
    local y = 3

    for i, cpu in ipairs(cpus) do
        if cpu.isBusy and cpu.craftingJob then
            -- Directly extract the variables from the nested job table
            local name = findValue(cpu.craftingJob, "displayName") or "Unknown Item"
            local qty = findValue(cpu.craftingJob, "count") or findValue(cpu.craftingJob, "amount") or 0
            
            monitor.setCursorPos(1, y)
            monitor.setTextColor(colors.white)
            monitor.write(string.format("%s x%d", name, qty))
            
            -- CPU ID
            monitor.setCursorPos(1, y + 1)
            monitor.setTextColor(colors.gray)
            monitor.write(string.format("  [%s]", cpu.name or "CPU " .. i))
            y = y + 3
        end
    end
end

while true do
    pcall(updateDisplay)
    sleep(1)
end
