-- Configuration
local BRIDGE_NAME = "meBridge"
local REFRESH_RATE = 2 -- Seconds between updates

local bridge = peripheral.find(BRIDGE_NAME)
local monitor = peripheral.find("monitor")
local termObj = monitor or term

if not bridge then
    error("ME Bridge not found! Is it connected to the network?")
end

-- Function to safely get a readable name
local function getReadableName(task)
    -- In modern AP, task often contains the item data directly 
    -- or nested under an 'item' key depending on the specific version.
    return task.displayName or (task.item and task.item.displayName) or task.name or "Unknown Item"
end

local function drawUI()
    local tasks = bridge.getCraftingTasks()
    
    termObj.clear()
    termObj.setCursorPos(1, 1)
    termObj.setTextColor(colors.yellow)
    termObj.write("=== AE2 ACTIVE TASKS ===")
    termObj.setTextColor(colors.white)

    if #tasks == 0 then
        termObj.setCursorPos(1, 3)
        termObj.write("System Idle...")
    else
        for i, task in ipairs(tasks) do
            if i > 10 then break end -- Prevent overflowing small screens
            
            local label = getReadableName(task)
            local amount = task.quantity or (task.item and task.item.amount) or 0
            
            termObj.setCursorPos(1, i + 2)
            -- Cleanly format: "128x Iron Ingot"
            termObj.write(string.format("%dx %s", amount, label))
        end
    end
end

-- Main Loop
term.clear()
print("Monitoring AE2... (Outputting to " .. (monitor and "Monitor" or "Terminal") .. ")")

while true do
    local ok, err = pcall(drawUI)
    if not ok then
        termObj.clear()
        termObj.setCursorPos(1,1)
        termObj.write("Error: " .. tostring(err))
    end
    sleep(REFRESH_RATE)
end
