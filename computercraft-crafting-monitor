local bridge = peripheral.wrap("bottom")
local monitor = peripheral.find("monitor")

if not bridge then error("ME Bridge not found on BOTTOM side!") end
if not monitor then error("Monitor not found!") end

monitor.setTextScale(0.5)

function updateDisplay()
  monitor.clear()
  monitor.setCursorPos(1, 1)
  monitor.setTextColor(colors.yellow)
  monitor.write("--- AE2 Active Crafting ---")
  
  local cpus = bridge.getCraftingCPUs()
  local y = 3
  local activeJobs = 0

  for i, cpu in ipairs(cpus) do
    -- check if the CPU is working
    if cpu.isBusy and cpu.craftingJob then
      activeJobs = activeJobs + 1
      local job = cpu.craftingJob
      
      -- 2026 FIX: The 'item' table contains the metadata
      local item = job.item or {}
      
      -- FIX: displayName and count are the standard 1.21 keys
      local name = item.displayName or item.label or "Unknown Item"
      local qty = job.count or item.count or 0
      
      monitor.setCursorPos(1, y)
      monitor.setTextColor(colors.white)
      monitor.write(string.format("%s x%d", name, qty))
      
      -- Optional: Display CPU storage/name
      monitor.setCursorPos(1, y + 1)
      monitor.setTextColor(colors.gray)
      local cpuName = cpu.name or "CPU " .. i
      monitor.write(string.format("  [%s] %dK Storage", cpuName, math.floor((cpu.storage or 0)/1024)))
      
      y = y + 3
    end
  end

  if activeJobs == 0 then
    monitor.setCursorPos(1, 3)
    monitor.setTextColor(colors.red)
    monitor.write("No active jobs.")
  end
end

while true do
  pcall(updateDisplay)
  sleep(1)
end
