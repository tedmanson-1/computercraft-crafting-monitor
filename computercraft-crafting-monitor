local bridge = peripheral.wrap("bottom")
local monitor = peripheral.find("monitor")
monitor.setTextScale(0.5)

local startCounts = {} -- Store initial counts in memory

local function findValue(tbl, key)
    if type(tbl) ~= "table" then return nil end
    if tbl[key] then return tbl[key] end
    for _, v in pairs(tbl) do
        local res = findValue(v, key)
        if res then return res end
    end
    return nil
end

function drawProgressBar(y, current, total)
    local width = 15
    -- Ensure total is never 0 to avoid math errors
    if not total or total <= 0 then total = current end
    
    -- AE2 counts DOWN. Progress = (Total - Remaining) / Total
    local percent = math.max(0, math.min(1, (total - current) / total))
    local filled = math.floor(percent * width)
    
    monitor.setCursorPos(1, y)
    monitor.setTextColor(colors.gray)
    monitor.write("[")
    monitor.setTextColor(colors.green)
    monitor.write(string.rep("=", filled))
    monitor.setTextColor(colors.black)
    monitor.write(string.rep("-", width - filled))
    monitor.setTextColor(colors.gray)
    monitor.write("] " .. math.floor(percent * 100) .. "%")
end

function updateDisplay()
    monitor.clear()
    monitor.setCursorPos(1, 1)
    monitor.setTextColor(colors.yellow)
    monitor.write("--- AE2 Active Crafting ---")
    
    local cpus = bridge.getCraftingCPUs()
    local y = 3
    local activeIDs = {}

    for i, cpu in ipairs(cpus) do
        if cpu.isBusy and cpu.craftingJob then
            local job = cpu.craftingJob
            local name = findValue(job, "displayName") or "Unknown"
            local currentQty = findValue(job, "count") or findValue(job, "amount") or 0
            
            -- Stable ID using the Item Name + CPU Index
            local jobID = name .. "_" .. i
            activeIDs[jobID] = true
            
            -- ONLY set the start count if we haven't seen this job before
            if not startCounts[jobID] then
                startCounts[jobID] = currentQty
            end

            -- Display: Blue Name, Green Count
            monitor.setCursorPos(1, y)
            monitor.setTextColor(colors.blue)
            monitor.write(name)
            monitor.setTextColor(colors.white)
            monitor.write(": ")
            monitor.setTextColor(colors.green)
            monitor.write(currentQty .. " Crafting")
            
			y = y + 3
        end
    end

    -- Cleanup: Remove jobs from memory that are no longer crafting
    for id, _ in pairs(startCounts) do
        if not activeIDs[id] then
            startCounts[id] = nil
        end
    end
end

while true do
    pcall(updateDisplay)
    sleep(1)
end
