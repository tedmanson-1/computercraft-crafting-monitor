-- Initializing peripherals using specific side
local bridge = peripheral.wrap("bottom") 
local monitor = peripheral.find("monitor")

if not bridge then error("ME Bridge not found on BOTTOM side!") end
if not monitor then error("Monitor not found! (Is it connected?)") end

-- Formatting
monitor.setTextScale(0.5)
local refreshRate = 2

function updateDisplay()
    monitor.clear()
    monitor.setCursorPos(1, 1)
    monitor.setTextColor(colors.yellow)
    monitor.write("--- AE2 Active Crafting Jobs ---")
    
    local cpus = bridge.getCraftingCPUs()
    local y = 3
    local activeJobs = 0

    for i, cpu in ipairs(cpus) do
        -- Check if CPU is busy and has a valid crafting job
        if cpu.isBusy and cpu.craftingJob then
            activeJobs = activeJobs + 1
            local job = cpu.craftingJob
            
            -- Try common 2026 field names for item display
            local itemName = job.displayName or job.label or job.name or "Unknown Item"
            local itemAmount = job.amount or job.count or 0
            
            monitor.setCursorPos(1, y)
            monitor.setTextColor(colors.white)
            monitor.write(string.format("%s x%d", itemName, itemAmount))
            
            -- Optional CPU Info
            monitor.setCursorPos(1, y + 1)
            monitor.setTextColor(colors.gray)
            local cpuName = cpu.name or "CPU " .. i
            monitor.write(string.format("  [%s]", cpuName))
            
            y = y + 3
        end
    end

    if activeJobs == 0 then
        monitor.setCursorPos(1, 3)
        monitor.setTextColor(colors.red)
        monitor.write("No active jobs.")
    end
end

-- Main Loop
while true do
    -- Using pcall to prevent crashing on data-sync hiccups
    local ok, err = pcall(updateDisplay)
    if not ok then
        print("Error: " .. tostring(err))
    end
    sleep(refreshRate)
end
