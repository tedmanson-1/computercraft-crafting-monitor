local bridge = peripheral.wrap("bottom")
local monitor = peripheral.find("monitor")
monitor.setTextScale(0.5)

local startCounts = {} -- Memory for progress

function updateDisplay()
    -- FORCED REFRESH: Re-pull all CPU data from the network
    local cpus = bridge.getCraftingCPUs()
    
    monitor.clear()
    monitor.setCursorPos(1, 1)
    monitor.setTextColor(colors.yellow)
    monitor.write("--- AE2 Live Status ---")
    
    local y = 3
    local activeIDs = {}

    for i, cpu in ipairs(cpus) do
        -- Only process CPUs that are actively working
        if cpu.isBusy and cpu.craftingJob then
            local job = cpu.craftingJob
            -- 2026 Path: Check job.item.count first, then job.count
            local itemData = job.item or {}
            local name = itemData.displayName or "Unknown"
            local current = job.count or itemData.count or 0
            
            local id = name .. "_" .. i
            activeIDs[id] = true
            
            -- Lock in the starting count
            if not startCounts[id] or current > (startCounts[id] or 0) then
                startCounts[id] = current
            end

            -- Display Name (Blue) and Live Count (Green)
            monitor.setCursorPos(1, y)
            monitor.setTextColor(colors.blue)
            monitor.write(name)
            monitor.setTextColor(colors.white)
            monitor.write(": ")
            monitor.setTextColor(colors.green)
            monitor.write(tostring(current) .. " left")

            -- Draw Progress Bar
            local total = startCounts[id]
            local width = 15
            local percent = (total > 0) and math.max(0, math.min(1, (total - current) / total)) or 0
            local filled = math.floor(percent * width)
            
            monitor.setCursorPos(1, y + 1)
            monitor.setTextColor(colors.gray)
            monitor.write("[" .. string.rep("=", filled) .. string.rep("-", width - filled) .. "] " .. math.floor(percent * 100) .. "%")
            
            y = y + 3
        end
    end

    -- Cleanup old jobs
    for id, _ in pairs(startCounts) do
        if not activeIDs[id] then startCounts[id] = nil end
    end
end

while true do
    -- Using pcall to prevent the script from stopping if the ME network reboots
    pcall(updateDisplay)
    sleep(1)
end
