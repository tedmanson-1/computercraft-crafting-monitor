local bridge = peripheral.wrap("bottom") 
local monitor = peripheral.find("monitor")

if not bridge then error("ME Bridge not found!") end
if not monitor then error("Monitor not found!") end

monitor.setTextScale(0.5)
local refreshRate = 2

function updateDisplay()
    monitor.clear()
    monitor.setCursorPos(1, 1)
    monitor.setTextColor(colors.yellow)
    monitor.write("--- AE2 Active Crafting Jobs ---")
    
    local cpus = bridge.getCraftingCPUs()
    local y = 3
    local activeJobs = 0

    for i, cpu in ipairs(cpus) do
        -- Safety check: Ensure both isBusy and the job data exist
        if cpu.isBusy and cpu.craftingJob then
            activeJobs = activeJobs + 1
            
            -- Fallback values if name or amount are missing
            local jobName = cpu.craftingJob.name or "Unknown Item"
            local jobAmount = cpu.craftingJob.amount or 0
            
            monitor.setCursorPos(1, y)
            monitor.setTextColor(colors.white)
            monitor.write(string.format("%s x%d", jobName, jobAmount))
            
            -- Show CPU status
            local storage = cpu.storage or 0
            monitor.setCursorPos(1, y + 1)
            monitor.setTextColor(colors.gray)
            monitor.write(string.format("  CPU: %dK", math.floor(storage / 1024)))
            
            y = y + 3
        end
    end

    if activeJobs == 0 then
        monitor.setCursorPos(1, 3)
        monitor.setTextColor(colors.red)
        monitor.write("No active jobs.")
    end
end

while true do
    -- Wrap in pcall to prevent the whole program from crashing on a minor error
    local success, err = pcall(updateDisplay)
    if not success then
        monitor.clear()
        monitor.setCursorPos(1,1)
        monitor.write("Error: " .. tostring(err))
    end
    sleep(refreshRate)
end
